# ---------------------------------------------------------------------------
# Environment configuration (copy to .env and fill in real values)
# ---------------------------------------------------------------------------

# Node environment: development | production
NODE_ENV=development

# Port the Express server listens on.
# Heroku sets this automatically; locally it defaults to 5000 if unset.
PORT=5000

# PostgreSQL connection string for the "postgresql-adjacent-16876" database.
# Heroku Postgres injects DATABASE_URL automatically in production.
# Local example:
#   postgresql://USER:PASSWORD@localhost:5432/postgresql-adjacent-16876
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/postgresql-adjacent-16876?schema=public"

# ---------------------------------------------------------------------------
# Client build-time variables (Vite). Must be prefixed with VITE_.
# ---------------------------------------------------------------------------
# Base URL the frontend uses to call the API. Leave empty to use same-origin.
VITE_API_URL=
